---
interface Props {
  expanded?: boolean;
}

const { expanded = false } = Astro.props;
const steps = [
  { action: "Resolve react-vite-spa v2", number: "01", result: "RECIPE" },
  { action: "Validate the complete plan", number: "02", result: "SAFE" },
  { action: "Write the staging tree", number: "03", result: "STAGE" },
  { action: "Publish the new destination", number: "04", result: "READY" },
] as const;
---

<figure class:list={["execution-proof", { "execution-proof--expanded": expanded }]}>
  <figcaption>
    <span>Project creation</span>
    <span class="execution-proof__scope">create-astilba 0.2.0</span>
  </figcaption>
  <ol aria-label="Create project generation sequence" class="execution-proof__steps">
    {steps.map((step) => (
      <li>
        <span aria-hidden="true" class="execution-proof__number">{step.number}</span>
        <span class="execution-proof__action">{step.action}</span>
        <span class={`execution-proof__result execution-proof__result--${step.result.toLowerCase()}`}>
          {step.result}
        </span>
      </li>
    ))}
  </ol>
  <div class="execution-proof__summary">
    <span><strong>4</strong> maintained recipes</span>
    <span><strong>1</strong> ownership manifest</span>
  </div>
</figure>
